<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <meta name="supported-color-schemes" content="light dark" />
  <title>Welcome to Prangon!</title>
  <style type="text/css">
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    body { margin: 0; padding: 0; width: 100% !important; background-color: #F8FAFC; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
    @media screen and (max-width: 600px) {
      .email-container { width: 100% !important; margin: 0 !important; }
      .content-padding { padding: 24px 20px !important; }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #F8FAFC; color: #1E293B;">
  <div style="display: none; font-size: 1px; color: #F8FAFC; line-height: 1px; max-height: 0px; max-width: 0px; opacity: 0; overflow: hidden; mso-hide: all;">
    <%= previewText || ('Welcome to Prangon! Your workspace ' + workspaceName + ' is ready.') %>
    &#847; &zwnj; &nbsp; &#8199; &shy; &#847; &zwnj; &nbsp; &#8199; &shy; &#847; &zwnj; &nbsp; &#8199; &shy; &#847; &zwnj; &nbsp; &#8199; &shy;
  </div>

  <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #F8FAFC; padding: 32px 12px;">
    <tr>
      <td align="center">
        <table border="0" cellpadding="0" cellspacing="0" width="100%" class="email-container" style="max-width: 560px; background-color: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
          
          <!-- Header -->
          <tr>
            <td align="left" style="padding: 28px 32px; background-color: #FFFFFF; border-bottom: 1px solid #F1F5F9;">
              <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td>
                    <table border="0" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="background-color: #2563EB; width: 34px; height: 34px; border-radius: 8px; text-align: center; vertical-align: middle; color: #FFFFFF; font-weight: 800; font-size: 18px; line-height: 34px;">
                          P
                        </td>
                        <td style="padding-left: 12px; font-size: 20px; font-weight: 700; color: #0F172A; letter-spacing: -0.5px;">
                          Prangon
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td align="right" style="font-size: 12px; color: #10B981; font-weight: 600; background-color: #ECFDF5; padding: 4px 10px; border-radius: 6px;">
                    <%= locals.planName ? (planName + ' Activated') : 'Workspace Ready' %>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td class="content-padding" style="padding: 32px 32px 24px 32px;">
              <h1 style="margin: 0 0 16px 0; font-size: 22px; font-weight: 700; color: #0F172A; line-height: 1.3;">
                Welcome to Prangon, <%= locals.name ? name : 'there' %>! 🎉
              </h1>
              
              <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #475569;">
                Your new workspace <strong><%= workspaceName %></strong> has been provisioned and is ready for you and your team.
              </p>

              <!-- Quick Start Steps -->
              <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; margin-bottom: 24px;">
                <tr>
                  <td style="padding: 20px;">
                    <p style="margin: 0 0 12px 0; font-size: 12px; font-weight: 700; text-transform: uppercase; color: #64748B; letter-spacing: 0.5px;">
                      Three Quick Ways to Start:
                    </p>
                    <table border="0" cellpadding="0" cellspacing="0" width="100%">
                      <tr>
                        <td style="vertical-align: top; font-size: 14px; font-weight: 700; color: #2563EB; width: 24px; line-height: 1.5;">1.</td>
                        <td style="font-size: 13px; line-height: 1.5; color: #334155; padding-bottom: 10px;">
                          <strong>Create a Project:</strong> Organize tasks, boards, and timelines for your deliverables.
                        </td>
                      </tr>
                      <tr>
                        <td style="vertical-align: top; font-size: 14px; font-weight: 700; color: #2563EB; width: 24px; line-height: 1.5;">2.</td>
                        <td style="font-size: 13px; line-height: 1.5; color: #334155; padding-bottom: 10px;">
                          <strong>Invite Teammates:</strong> Add collaborators with customized Owner, Admin, or Member permissions.
                        </td>
                      </tr>
                      <tr>
                        <td style="vertical-align: top; font-size: 14px; font-weight: 700; color: #2563EB; width: 24px; line-height: 1.5;">3.</td>
                        <td style="font-size: 13px; line-height: 1.5; color: #334155;">
                          <strong>Explore Docs:</strong> Read guides on keyboard shortcuts, Kanban boards, and billing.
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- CTA -->
              <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 28px 0 24px 0;">
                <tr>
                  <td align="center">
                    <table border="0" cellpadding="0" cellspacing="0">
                      <tr>
                        <td align="center" style="border-radius: 8px; background-color: #2563EB;">
                          <a href="<%= workspaceUrl %>" target="_blank" style="font-size: 14px; font-weight: 600; color: #FFFFFF; text-decoration: none; padding: 14px 32px; border-radius: 8px; display: inline-block;">
                            Go to Your Dashboard &rarr;
                          </a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <p style="margin: 0; font-size: 13px; line-height: 1.5; color: #64748B;">
                Need help? Reply directly to this email or visit our <a href="<%= frontendUrl %>/docs" style="color: #2563EB; text-decoration: underline;">documentation</a>.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding: 24px 32px; background-color: #F8FAFC; border-top: 1px solid #F1F5F9; font-size: 12px; color: #94A3B8; line-height: 1.6;">
              <p style="margin: 0 0 6px 0;">
                <%= companyAddress %>
              </p>
              <p style="margin: 0;">
                © <%= currentYear %> Prangon Technologies. All rights reserved. &bull; 
                <a href="<%= frontendUrl %>/legal/privacy" style="color: #2563EB; text-decoration: underline;">Privacy</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
