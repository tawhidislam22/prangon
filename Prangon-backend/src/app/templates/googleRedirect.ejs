<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redirecting to Google...</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        body {
            background-color: #f8fafc;
            color: #0f172a;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 1.5rem;
        }
        .card {
            background: #ffffff;
            border-radius: 1rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
            border: 1px solid #e2e8f0;
            padding: 2.5rem;
            max-width: 420px;
            width: 100%;
            text-align: center;
        }
        .spinner {
            width: 48px;
            height: 48px;
            border: 4px solid #e2e8f0;
            border-top: 4px solid #3b82f6;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 1.5rem;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: #1e293b;
        }
        .subtitle {
            font-size: 0.95rem;
            color: #64748b;
            line-height: 1.5;
        }
        .error-card {
            border-color: #fecaca;
            background-color: #fff;
        }
        .error-icon {
            width: 48px;
            height: 48px;
            background-color: #fee2e2;
            color: #ef4444;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.25rem;
            font-size: 1.5rem;
            font-weight: bold;
        }
        .error-message {
            font-size: 0.9rem;
            color: #dc2626;
            background: #fef2f2;
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            margin: 1rem 0 1.5rem;
            word-break: break-word;
        }
        .btn {
            display: inline-block;
            background-color: #0f172a;
            color: #ffffff;
            text-decoration: none;
            padding: 0.65rem 1.25rem;
            border-radius: 0.5rem;
            font-size: 0.9rem;
            font-weight: 500;
            transition: background-color 0.15s ease;
        }
        .btn:hover {
            background-color: #334155;
        }
    </style>
</head>
<body>
    <div id="content" class="card">
        <div class="spinner"></div>
        <h1 class="title">Redirecting to Google...</h1>
        <p class="subtitle">Please wait while we connect your account securely.</p>
    </div>

    <script>
        (async () => {
            const content = document.getElementById("content");
            const betterAuthUrl = "<%= betterAuthUrl %>".trim();
            const callbackURL = "<%= callbackURL %>".trim();
            const frontendUrl = "<%= frontendUrl || 'http://localhost:3000' %>".trim();

            const renderError = (message) => {
                content.className = "card error-card";
                content.innerHTML = `
                    <div class="error-icon">!</div>
                    <h1 class="title">Google Sign-In Error</h1>
                    <p class="subtitle">An error occurred while redirecting to Google. Please try again later.</p>
                    <div class="error-message">${message}</div>
                    <a href="${frontendUrl}/login" class="btn">Return to Login</a>
                `;
            };

            try {
                // Request sign-in URL from Better Auth.
                // Use relative path '/api/auth/sign-in/social' first so it's always same-origin with the page.
                let response;
                const bodyPayload = JSON.stringify({
                    provider: "google",
                    callbackURL: callbackURL
                });

                try {
                    response = await fetch("/api/auth/sign-in/social", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        credentials: "include",
                        body: bodyPayload
                    });
                } catch (fetchErr) {
                    // Fallback to absolute betterAuthUrl if relative fetch fails
                    if (betterAuthUrl && !fetchErr.name?.includes("AbortError")) {
                        response = await fetch(`${betterAuthUrl}/api/auth/sign-in/social`, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            credentials: "include",
                            body: bodyPayload
                        });
                    } else {
                        throw fetchErr;
                    }
                }

                const data = await response.json().catch(() => null);

                if (!response.ok) {
                    const message = data?.message || data?.error || `Server returned status ${response.status}`;
                    renderError(message);
                    return;
                }

                if (data && data.url) {
                    window.location.href = data.url;
                } else {
                    renderError("No redirect URL was returned by the authentication server.");
                }
            } catch (error) {
                renderError(error?.message || "Failed to connect to authentication server.");
            }
        })();
    </script>
</body>
</html>