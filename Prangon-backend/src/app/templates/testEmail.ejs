<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <title>Prangon Email Deliverability Test</title>
  <style type="text/css">
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    body { margin: 0; padding: 0; width: 100% !important; background-color: #F8FAFC; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
    @media screen and (max-width: 600px) {
      .email-container { width: 100% !important; margin: 0 !important; }
      .content-padding { padding: 24px 20px !important; }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #F8FAFC; color: #1E293B;">
  <div style="display: none; font-size: 1px; color: #F8FAFC; line-height: 1px; max-height: 0px; max-width: 0px; opacity: 0; overflow: hidden; mso-hide: all;">
    Deliverability test message from Prangon Mail Delivery Engine. All checks passed.
    &#847; &zwnj; &nbsp; &#8199; &shy; &#847; &zwnj; &nbsp; &#8199; &shy; &#847; &zwnj; &nbsp; &#8199; &shy; &#847; &zwnj; &nbsp; &#8199; &shy;
  </div>

  <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #F8FAFC; padding: 32px 12px;">
    <tr>
      <td align="center">
        <table border="0" cellpadding="0" cellspacing="0" width="100%" class="email-container" style="max-width: 560px; background-color: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
          
          <!-- Header -->
          <tr>
            <td align="left" style="padding: 28px 32px; background-color: #FFFFFF; border-bottom: 1px solid #F1F5F9;">
              <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td>
                    <table border="0" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="background-color: #10B981; width: 34px; height: 34px; border-radius: 8px; text-align: center; vertical-align: middle; color: #FFFFFF; font-weight: 800; font-size: 18px; line-height: 34px;">
                          ✓
                        </td>
                        <td style="padding-left: 12px; font-size: 20px; font-weight: 700; color: #0F172A; letter-spacing: -0.5px;">
                          Prangon Mailer
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td align="right" style="font-size: 12px; color: #059669; font-weight: 600; background-color: #D1FAE5; padding: 4px 10px; border-radius: 6px;">
                    Test Passed (10/10)
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td class="content-padding" style="padding: 32px 32px 24px 32px;">
              <h1 style="margin: 0 0 16px 0; font-size: 22px; font-weight: 700; color: #0F172A; line-height: 1.3;">
                Deliverability Test Successful! 🚀
              </h1>
              
              <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #475569;">
                If you are reading this in your <strong>Primary Inbox</strong>, your SMTP server configuration, anti-spam headers, and multipart MIME structure are functioning with high reputation!
              </p>

              <!-- Diagnostic Specs Table -->
              <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; margin-bottom: 24px;">
                <tr>
                  <td style="padding: 16px 20px;">
                    <p style="margin: 0 0 12px 0; font-size: 12px; font-weight: 700; text-transform: uppercase; color: #64748B;">
                      Diagnostic Specs:
                    </p>
                    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="font-size: 12px; line-height: 1.8;">
                      <tr>
                        <td style="color: #64748B;">SMTP Host:</td>
                        <td align="right" style="font-family: monospace; font-weight: 600; color: #0F172A;"><%= locals.smtpHost || 'smtp.gmail.com:465' %></td>
                      </tr>
                      <tr>
                        <td style="color: #64748B;">MIME Type:</td>
                        <td align="right" style="font-weight: 600; color: #059669;">multipart/alternative (HTML + Text)</td>
                      </tr>
                      <tr>
                        <td style="color: #64748B;">RFC Headers:</td>
                        <td align="right" style="font-weight: 600; color: #059669;">Message-ID, Unsubscribe, Precedence</td>
                      </tr>
                      <tr>
                        <td style="color: #64748B;">Recipient:</td>
                        <td align="right" style="font-weight: 600; color: #0F172A;"><%= locals.toEmail || 'Verified Recipient' %></td>
                      </tr>
                      <tr>
                        <td style="color: #64748B;">Dispatched At:</td>
                        <td align="right" style="color: #64748B;"><%= locals.timestamp || new Date().toISOString() %></td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Anti-Spam Check list -->
              <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #F0FDF4; border: 1px solid #BBF7D0; border-radius: 8px; margin-bottom: 20px;">
                <tr>
                  <td style="padding: 14px 18px; font-size: 13px; line-height: 1.5; color: #166534;">
                    <strong>Anti-Spam Verification Checklist:</strong>
                    <ul style="margin: 8px 0 0 0; padding-left: 20px; font-size: 12px;">
                      <li>Zero-width preheader prevents code leakage into snippet</li>
                      <li>Plain-text counterpart prevents SpamAssassin HTML_ONLY trigger</li>
                      <li>CAN-SPAM compliant postal address & unsubscribe links</li>
                      <li>Secure TLS 1.3 encrypted transport</li>
                    </ul>
                  </td>
                </tr>
              </table>

              <p style="margin: 0; font-size: 12px; line-height: 1.5; color: #64748B;">
                This test was initiated from the Prangon Platform Admin Console.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding: 24px 32px; background-color: #F8FAFC; border-top: 1px solid #F1F5F9; font-size: 12px; color: #94A3B8; line-height: 1.6;">
              <p style="margin: 0 0 6px 0;">
                <%= companyAddress %>
              </p>
              <p style="margin: 0;">
                © <%= currentYear %> Prangon Technologies. All rights reserved. &bull; 
                <a href="<%= frontendUrl %>/legal/privacy" style="color: #2563EB; text-decoration: underline;">Privacy</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
